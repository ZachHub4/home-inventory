# Virtual environment
venv/

# Python
__pycache__/
*.py[cod]

# Your actual inventory data - never commit this
inventory.db
inventory.db-journal

# Uploaded item photos - never commit these
static/uploads/*
!static/uploads/.gitkeep

# TLS certificates and keys - the CA key must never leave this machine
certs/

# OS noise
.DS_Store
Thumbs.db
